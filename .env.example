NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_SITE_URL=https://lims.example.com

# AI chatbot service (lims-chatbot-service, NestJS + LangGraph.js) - separate
# from the main API above. In production this defaults to "/ai" (same
# origin as this app, behind the shared gateway) and needs no override. For
# local dev, point it at wherever `npm run start:dev` serves that repo -
# note it exposes a bare "/chat" route standalone (no /ai prefix), so the
# value here should be the full base the local service actually listens on.
NEXT_PUBLIC_CHATBOT_API_URL=http://localhost:3000
